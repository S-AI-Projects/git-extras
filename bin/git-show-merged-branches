#!/usr/bin/env bash

if ! command -v grep &>/dev/null; then
  echo "grep required." 1>&2
  exit 1
fi

if ! command -v sed &>/dev/null; then
  echo "sed required." 1>&2
  exit 1
fi

default_branch=$(git_extra_default_branch)
target="${1:-HEAD}"
git branch --no-color --merged "$target" | grep -vE "^(\*|\+)" | sed 's/^[ ]*//' | grep -Fvx -e "$default_branch" -e "main" -e "master" -e "trunk" -e "svn" || true
