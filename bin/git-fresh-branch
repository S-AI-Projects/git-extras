#!/usr/bin/env bash

case "$1" in
  -h|--help)
    echo "Usage: git fresh-branch <branchname>"
    exit 0
    ;;
  -*)
    echo "error: unknown option $1" >&2
    exit 1
    ;;
esac

branch=$1

test -z "$branch" && echo "branch required." >&2 && exit 1

if [ $# -gt 1 ]; then
  echo "error: too many arguments" >&2
  exit 1
fi

changes=$(git status --porcelain)

clean() {
  git symbolic-ref HEAD "refs/heads/$branch"
  git_dir=$(git rev-parse --git-dir)
  rm -f "$git_dir/index"
  git clean -fdx
}

if [ -n "$changes" ]; then
  read -rp "All untracked changes will be lost. Continue [y/N]? " res
  case $res in
    [Yy]* ) ;;
    * ) exit 0;;
  esac
fi

clean
