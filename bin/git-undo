#!/usr/bin/env bash

_usage() {
  cat << EOL
Usage: git undo [OPTIONS] [<commitcount>]

Options:
  -s, --soft        Roll back commit(s) but leave changes in staging area.
  -h, --hard        Wipe commit(s) and changes completely.
  -c, --count <n>   Number of commits to remove.
  --help            Show this help message.
EOL
}

parm1="soft"
parm2=""
parm3=""
hard_prompt=0

while [ $# -gt 0 ]; do
  case "$1" in
    help|--help)
      _usage
      exit 0
      ;;
    -h)
      hard_prompt=1
      parm1="hard"
      shift
      ;;
    --hard)
      parm1="hard"
      shift
      ;;
    -s|--soft)
      parm1="soft"
      parm3="reset"
      shift
      ;;
    -c|--count)
      if [ -z "$2" ]; then
        echo "Option $1 requires an argument"
        exit 1
      fi
      parm2="$2"
      shift 2
      ;;
    --count=*)
      parm2="${1#*=}"
      shift
      ;;
    *[!0-9]*)
      echo "Invalid parameter: $1"
      exit 1
      ;;
    *)
      if [ -z "$parm2" ]; then
        parm2="$1"
      else
        echo "Invalid parameter: $1"
        exit 1
      fi
      shift
      ;;
  esac
done

if [ "$hard_prompt" -eq 1 ]; then
  cat << EOL
This will erase any changes since your last commit.
If you want to get help info, run "git undo --help" instead.
Do you want to continue? [yN]"
EOL
  read -r res
  case "${res}" in
    "Y" | "y")
      ;;
    *)
      exit 0
      ;;
  esac
fi

parm2=${parm2:-1}

if [[ ! $parm2 =~ ^[1-9][0-9]*$ ]]; then
  echo "Invalid undo count: $parm2"
  exit 1
fi

if ! command -v is_git_repo &>/dev/null; then
  if ! git rev-parse --git-dir &>/dev/null; then
    echo "Not a git repo!" >&2
    exit 1
  fi
fi

if ! command -v has_git_commit &>/dev/null; then
  if ! git rev-parse --short HEAD &>/dev/null; then
    echo "Not git commit found!" >&2
    exit 1
  fi
fi

cstr="commits"
ccnt=$(git rev-list --count HEAD)
if [ "$ccnt" -eq 1 ]; then cstr="commit"; fi

_undo() {
  type=${1:-soft}
  undo_cnt=${2:-1}
  reset=${3:-""}

  if [ "$undo_cnt" -gt "$ccnt" ]; then
    echo "Only $ccnt $cstr, cannot undo $undo_cnt"
    exit 1
  elif [ "$type" = "hard" ] && [ "$ccnt" -eq "$undo_cnt" ]; then
    echo "Cannot hard undo all commits"
    exit 1
  elif [ "$type" = "soft" ] && [ "$ccnt" -eq 1 ]; then
    git update-ref -d HEAD
  else
    git reset "--$type" "HEAD~$undo_cnt"
  fi
  if [ "$reset" != "" ]; then git reset; fi
}

_undo "$parm1" "$parm2" "$parm3"
