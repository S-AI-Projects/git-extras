#!/usr/bin/env bash
set -e

case "$1" in
  -h|--help)
    echo "Usage: git rename-branch [<old-branch>] <new-branch>"
    exit 0
    ;;
  -*)
    echo "error: unknown option $1" >&2
    exit 1
    ;;
esac

# Assert there is at least one branch provided
test -z "$1" && echo "new branch name required." >&2 && exit 1

if [ $# -gt 2 ]; then
  echo "error: too many arguments" >&2
  exit 1
fi

if [ -z "$2" ]; then
  new_branch="$1"
  old_branch="$(git symbolic-ref --short -q HEAD || true)"
  if [ -z "$old_branch" ]; then
    echo "error: cannot rename current branch while not on any." >&2
    exit 1
  fi
else
  case "$2" in
    -*)
      echo "error: invalid branch name $2" >&2
      exit 1
      ;;
  esac
  new_branch="$2"
  old_branch="$1"
fi

remote=$(git config branch."$old_branch".remote || true)

git branch -m "$old_branch" "$new_branch"
# check if the branch is tracking a remote branch
if [[ -n "$remote" && "$remote" != "." ]]
then
  git push "$remote" :"$old_branch"
  git push --set-upstream "$remote" "$new_branch"
fi

