#!/usr/bin/env bash

usage() {
  echo "Usage: git info [-c|--color] [--no-config]"
  echo "       git info -h|--help"
}

GREEN="$(tput setaf 2 2>/dev/null || true)"
NORMAL="$(tput sgr0 2>/dev/null || true)"
COLOR_TITLE="$NORMAL"
HIDE_CONFIG=1

while [ $# -gt 0 ]; do
  case "$1" in
    -c|--color)
      COLOR_TITLE="$GREEN"
      ;;
    --no-config)
      HIDE_CONFIG=
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "git-info: unknown option '$1'" >&2
      echo "Troubleshooting: run 'git info -h' or refer to 'git info --help' for valid options." >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

get_config() {
  cmd_get_config="$(git config --get-all git-extras.info.config-grep)"
  if [ -z "$cmd_get_config" ]; then
    git config --list
  else
    if ! output=$(eval "$cmd_get_config"); then
      echo "git-info: failed to execute git-extras.info.config-grep: '$cmd_get_config'" >&2
      echo "Troubleshooting: verify the command in 'git config git-extras.info.config-grep' or use '--no-config'." >&2
      return 1
    fi
    echo "$output"
  fi
}

most_recent_commit() {
  cmd_get_log="$(git config --get-all git-extras.info.log)"
  if [ -z "$cmd_get_log" ]; then
    git log --max-count=1 --pretty=short
  else
    if ! output=$(eval "$cmd_get_log"); then
      echo "git-info: failed to execute git-extras.info.log: '$cmd_get_log'" >&2
      echo "Troubleshooting: verify the command in 'git config git-extras.info.log'." >&2
      return 1
    fi
    echo "$output"
  fi
}

submodules() {
  # short sha1
  git submodule status | sed 's/\([^abcdef0-9]\{0,2\}\)\([abcdef0-9]\{7\}\)\([abcdef0-9]\{33\}\)\(.*\)/\1\2\4/'
}

local_branches() {
  git branch
}

remote_branches() {
  git branch -r
}

remote_urls() {
  git remote -v
}

echon() {
  echo "$@"
  echo
}

echo
echon "${COLOR_TITLE}## Remote URLs:${NORMAL}"
echon "$(remote_urls)"

echon "${COLOR_TITLE}## Remote Branches:${NORMAL}"
echon "$(remote_branches)"

echon "${COLOR_TITLE}## Local Branches:${NORMAL}"
echon "$(local_branches)"

SUBMODULES_LOG=$(submodules)
if [ -n "$SUBMODULES_LOG" ]; then
  echon "${COLOR_TITLE}## Submodule(s):${NORMAL}"
  echon "$SUBMODULES_LOG"
fi

echon "${COLOR_TITLE}## Most Recent Commit:${NORMAL}"
if ! commit_output="$(most_recent_commit)"; then
  exit 1
fi
echon "$commit_output"

if [ -n "$HIDE_CONFIG" ]; then
  echon "${COLOR_TITLE}## Configuration (.git/config):${NORMAL}"
  if ! config_output="$(get_config)"; then
    exit 1
  fi
  echon "$config_output"
fi
